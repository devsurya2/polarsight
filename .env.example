# ─────────────────────────────────────────────────────────────
# POLARSIGHT — environment template
#
# Copy to .env and fill in real values. Never commit .env.
#   cp .env.example .env
#
# Every secret below must be unique per environment. The values
# here are placeholders and are not safe for anything but local
# development.
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# Credentials for the project's own Postgres container. These
# must match the values docker-compose.yml starts the container
# with. They are deliberately separate from any system Postgres.
POSTGRES_USER=polarsight
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=polarsight
POSTGRES_PORT=5433

# Prisma connection string, assembled from the values above.
DATABASE_URL="postgresql://polarsight:change_me_locally@localhost:5433/polarsight?schema=public"

# ── API ──────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=5000
API_URL=http://localhost:5000
# Public website base URL, used to build page preview links.
WEB_URL=http://localhost:3000

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Authentication ───────────────────────────────────────────
# Generate strong, DIFFERENT values for each:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Cookie settings. COOKIE_SECURE must be true in production.
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Seeded first administrator. Change the password immediately
# after the first login, and never reuse it elsewhere.
SEED_ADMIN_EMAIL=admin@polarsight.in
SEED_ADMIN_PASSWORD=ChangeThisNow!2026

# Shared between the API and the website so a publish refreshes the
# site immediately instead of waiting for its one-minute window.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REVALIDATE_SECRET=replace_with_a_long_random_string

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=8

# ── Media storage ────────────────────────────────────────────
# "local" is the only driver implemented: uploads are written to
# STORAGE_LOCAL_DIR on the API's own disk. In production that path
# must be a persistent volume written to by one instance only.
# Media files are never stored in Postgres; only their metadata is.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_PUBLIC_URL=http://localhost:5000/media

# ── Front ends ───────────────────────────────────────────────
# Public site: read-only published content.
NEXT_PUBLIC_API_URL=http://localhost:5000
# Public website base URL, used to build page preview links.
WEB_URL=http://localhost:3000
# Admin portal.
VITE_API_URL=http://localhost:5000
# Public website base URL, used to build page preview links.
WEB_URL=http://localhost:3000
# Where the admin header's "View website" link points.
VITE_WEB_URL=http://localhost:3000

# ── Public contact details ───────────────────────────────────
# These appear on the website, so they are NEXT_PUBLIC_ and are
# inlined into the browser bundle. Never put a secret here.
#
# There is no fallback for any of them. Leave one blank and the
# site omits that field entirely rather than showing a made-up
# address. Fill in only what is real, and rebuild the site after
# changing any of these: NEXT_PUBLIC_ values are baked in at
# build time, not read at runtime.

# Main address shown on the contact page, in the footer and on
# the homepage contact block.
NEXT_PUBLIC_CONTACT_EMAIL=
# Shown with a tel: link. Any format; punctuation is stripped for
# the link itself. Example: +91 44 1234 5678
NEXT_PUBLIC_CONTACT_PHONE=

# Optional routing addresses for the contact page. Leave blank to
# show only the main address above.
NEXT_PUBLIC_INSTITUTIONAL_EMAIL=
NEXT_PUBLIC_BUSINESS_EMAIL=

# Social profiles. Full URLs. A blank value removes that icon.
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_GITHUB=

# ── Security (added by the security hardening) ───────────────
# Only true behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Sign-in attempts per address across all accounts, per window.
LOGIN_IP_RATE_LIMIT_MAX=30
# Roles that must use two-factor authentication. Defaults to
# "Super Admin" in production and nobody in development.
MFA_REQUIRED_ROLES=
# 32 random bytes, base64url. Encrypts TOTP seeds at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MFA_ENCRYPTION_KEY=replace_with_32_random_bytes_base64url
# Private files: applicant resumes and uploads awaiting their scan.
STORAGE_PRIVATE_DIR=./private-uploads
# Resume uploads: PDF only, at most this many bytes.
RESUME_MAX_BYTES=5242880
# ClamAV daemon. Unset = uploads cannot be scanned (resumes stay
# quarantined; production refuses to start). docker compose --profile
# scan up -d clamav starts one locally.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
