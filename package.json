{
  "name": "polarsight",
  "private": true,
  "version": "0.1.0",
  "description": "POLARSIGHT monorepo: public website, admin portal and backend API.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:admin dev:api",
    "dev:web": "npm run dev --workspace @polarsight/web",
    "dev:admin": "npm run dev --workspace @polarsight/admin",
    "dev:api": "npm run dev --workspace @polarsight/api",
    "build": "npm-run-all build:api build:admin build:web",
    "build:web": "npm run build --workspace @polarsight/web",
    "build:admin": "npm run build --workspace @polarsight/admin",
    "build:api": "npm run build --workspace @polarsight/api",
    "lint": "npm-run-all --continue-on-error lint:*",
    "lint:web": "echo \"apps/web: Next 16 removed 'next lint'; the website is covered by typecheck+build, Semgrep (CI) and the e2e suite\"",
    "lint:admin": "npm run lint --workspace @polarsight/admin",
    "lint:api": "npm run lint --workspace @polarsight/api",
    "typecheck": "npm-run-all --continue-on-error typecheck:*",
    "typecheck:admin": "npm run typecheck --workspace @polarsight/admin",
    "typecheck:api": "npm run typecheck --workspace @polarsight/api",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "npm run db:migrate --workspace @polarsight/api",
    "db:seed": "npm run db:seed --workspace @polarsight/api",
    "db:studio": "npm run db:studio --workspace @polarsight/api",
    "db:reset": "npm run db:reset --workspace @polarsight/api",
    "test": "npm-run-all --continue-on-error test:*",
    "test:api": "python3 apps/api/tests/integration.py",
    "typecheck:web": "echo \"apps/web is plain JavaScript; no typecheck\"",
    "test:e2e": "python3 apps/api/tests/end_to_end.py",
    "test:security": "python3 apps/api/tests/security.py",
    "security:audit": "npm audit --audit-level=moderate",
    "security:secrets": "gitleaks detect --source . --no-banner --redact",
    "security:sbom": "npm sbom --sbom-format cyclonedx --package-lock-only > sbom.cdx.json",
    "media:rescan": "npm run media:rescan --workspace @polarsight/api",
    "media:cleanup": "npm run media:cleanup --workspace @polarsight/api"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "bcrypt@5.1.1": true,
    "esbuild@0.28.2": true,
    "prisma@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "esbuild@0.25.12": true
  }
}
